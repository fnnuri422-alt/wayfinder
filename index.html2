<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#5367e8">
<title>Wayfinder | Your World, Your Way</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root{--blue:#5367e8;--purple:#8054d9;--ink:#20233a;--muted:#70758d;--bg:#f5f6ff;--card:#fff;--line:#e8e9f4;--danger:#d94b62}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Arial,sans-serif}button,input,textarea,select{font:inherit}button{border:0;border-radius:11px;padding:10px 14px;background:linear-gradient(110deg,var(--blue),var(--purple));color:white;font-weight:700;cursor:pointer}button:disabled{opacity:.5}button.secondary{background:#eef0ff;color:#4d55bb}button.danger{background:#fff0f2;color:var(--danger)}input,textarea,select{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);margin:5px 0 12px}textarea{min-height:90px;resize:vertical}.wrap{max-width:1100px;margin:auto;padding:16px}.hero{background:linear-gradient(120deg,#5367e8,#8054d9);color:white;border-radius:20px;padding:24px;margin:14px 0}.hero h1{margin:0;font-size:30px}.muted,.small{color:var(--muted)}.small{font-size:12px}.card,.item{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin:12px 0;box-shadow:0 4px 16px #28306b08}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}.tabs{display:flex;gap:8px;overflow-x:auto;padding:8px 0;position:sticky;top:0;background:var(--bg);z-index:20}.tabs button{white-space:nowrap;background:#e9ebfb;color:#4b50a6}.tabs button.active{background:linear-gradient(110deg,var(--blue),var(--purple));color:white}.hidden{display:none!important}.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.row>*{flex:1}.pill{display:inline-block;padding:4px 9px;border-radius:30px;background:#eff0ff;color:#555bb9;font-size:12px}.msg{min-height:20px;color:var(--muted);font-size:13px}#map{height:360px;border-radius:14px;z-index:1}.top{display:flex;justify-content:space-between;align-items:center;gap:12px}.brand{font-weight:900;color:var(--blue);font-size:20px}.item h3{margin:6px 0}.item p{margin:6px 0}.item button{margin:5px 5px 0 0}.progress{height:9px;background:#eceeff;border-radius:20px;overflow:hidden}.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--purple))}@media(max-width:600px){.wrap{padding:10px}.hero{padding:19px}.hero h1{font-size:25px}.tabs{margin:0 -10px;padding:8px 10px}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top"><div class="brand">✦ WAYFINDER</div><span class="small">Your World, Your Way.</span></div>
  <section id="authSection" class="card">
    <div class="hero"><h1>Discover your next chapter.</h1><p>Explore places, learn skills, plan journeys and connect with a global community.</p></div>
    <h2>Welcome to Wayfinder</h2>
    <div class="grid">
      <div><label>Email</label><input id="email" type="email" placeholder="you@example.com"><label>Password</label><input id="password" type="password" placeholder="At least 6 characters"><div class="row"><button onclick="signIn()">Log in</button><button class="secondary" onclick="signUp()">Create account</button></div><button class="secondary" onclick="resetPassword()">Reset password</button><p id="authMsg" class="msg"></p></div>
      <div class="item"><h3>One world. Many possibilities.</h3><p class="muted">Create an account to save discoveries, share ideas and keep your plans together.</p><p class="small">Use the email address you registered with.</p></div>
    </div>
  </section>
  <main id="appSection" class="hidden">
    <div class="hero"><div class="top"><div><h1>Your world, your way.</h1><p>Make every discovery count.</p></div><button class="secondary" onclick="signOut()">Log out</button></div></div>
    <nav class="tabs" id="tabs">
      <button class="active" data-page="community" onclick="showPage('community',this)">Community</button>
      <button data-page="explore" onclick="showPage('explore',this)">Explore</button>
      <button data-page="countries" onclick="showPage('countries',this)">Countries</button>
      <button data-page="mapPage" onclick="showPage('mapPage',this)">World Map</button>
      <button data-page="universities" onclick="showPage('universities',this)">Universities</button>
      <button data-page="travel" onclick="showPage('travel',this)">Travel</button>
      <button data-page="journey" onclick="showPage('journey',this)">Journey AI</button>
      <button data-page="languages" onclick="showPage('languages',this)">Languages</button>
      <button data-page="career" onclick="showPage('career',this)">Career</button>
      <button data-page="alerts" onclick="showPage('alerts',this)">Alerts</button>
      <button data-page="saved" onclick="showPage('saved',this)">Saved</button>
      <button data-page="profile" onclick="showPage('profile',this)">Profile</button>
    </nav>

    <section id="community" class="page">
      <div class="card"><h2>Community</h2><textarea id="postText" placeholder="Share an idea, question or discovery..."></textarea><button onclick="createPost()">Publish post</button><p id="postMsg" class="msg"></p></div>
      <div id="feed"></div>
    </section>

    <section id="explore" class="page hidden">
      <div class="card"><h2>Explore discoveries</h2><input id="exploreSearch" placeholder="Search places, study, skills..." oninput="renderExplore()"><select id="exploreCategory" onchange="renderExplore()"><option>All</option><option>Study</option><option>Travel</option><option>Career</option><option>Culture</option><option>Skills</option></select><p id="exploreCount" class="small"></p><div id="exploreList"></div></div>
    </section>

    <section id="countries" class="page hidden"><div class="card"><h2>Countries</h2><input id="countrySearch" placeholder="Search country or capital..." oninput="renderCountries()"><div id="countryList" class="grid"></div></div></section>
    <section id="mapPage" class="page hidden"><div class="card"><h2>World Map</h2><p class="muted">Explore the world map. Tap a marker for a location.</p><div id="map"></div></div></section>

    <section id="universities" class="page hidden"><div class="card"><h2>University discovery</h2><input id="uniSearch" placeholder="Search university or country..." oninput="renderUniversities()"><div id="uniList" class="grid"></div><p class="small">Starter directory only. Always verify current admission, tuition and scholarship details with each university.</p></div></section>

    <section id="travel" class="page hidden"><div class="card"><h2>Travel planner</h2><label>Destination</label><input id="tripDestination" placeholder="e.g. Kuala Lumpur, Malaysia"><label>Travel date</label><input id="tripDate" type="date"><label>Notes</label><textarea id="tripNotes" placeholder="Places to visit, budget notes..."></textarea><button onclick="saveTrip()">Save travel plan</button><p id="tripMsg" class="msg"></p><div id="tripList"></div></div></section>

    <section id="journey" class="page hidden"><div class="card"><h2>Journey planner</h2><p class="muted">Create a simple starter roadmap based on your goal.</p><label>Your goal</label><select id="goalChoice"><option value="study">Study abroad</option><option value="career">Build a career</option><option value="travel">Plan a journey</option><option value="language">Learn a language</option></select><label>Time available</label><select id="goalTime"><option>3 months</option><option>6 months</option><option>1 year</option><option>2 years</option></select><button onclick="makeJourney()">Build my roadmap</button><div id="journeyResult"></div></div></section>

    <section id="languages" class="page hidden"><div class="card"><h2>Language practice</h2><select id="languageChoice" onchange="phraseIndex=0;renderPhrase()"><option value="Japanese">Japanese</option><option value="Korean">Korean</option><option value="German">German</option><option value="English">English</option><option value="Malay">Malay</option></select><div id="phraseCard" class="item"></div><button onclick="nextPhrase()">Next phrase</button></div></section>

    <section id="career" class="page hidden"><div class="card"><h2>Skills tracker</h2><input id="skillName" placeholder="Add a skill (e.g. Python)"><button onclick="addSkill()">Add skill</button><p id="skillMsg" class="msg"></p><div id="skillList"></div></div></section>
    <section id="alerts" class="page hidden"><div class="card"><h2>Notifications</h2><div id="notificationList"></div></div></section>
    <section id="saved" class="page hidden"><div class="card"><h2>Saved discoveries</h2><div id="savedList"></div></div></section>
    <section id="profile" class="page hidden"><div class="card"><h2>Your profile</h2><label>Full name</label><input id="profileName" placeholder="Your name"><button onclick="saveProfile()">Save profile</button><p id="profileMsg" class="msg"></p></div></section>
  </main>
  <footer class="small" style="text-align:center;padding:24px">© 2026 Wayfinder. All rights reserved.<br>Your World, Your Way.</footer>
</div>
<script>
'use strict';
const SUPABASE_URL='https://govrnoanaxxvefpymkig.supabase.co';
const SUPABASE_KEY='sb_publishable_PnKKyNIeSawvmwZw0J4VfQ_wTrFcUKj';
const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
let currentUser=null,map=null,phraseIndex=0;
const el=id=>document.getElementById(id);
const safe=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const errText=e=>e?.message||String(e||'Unknown error');
function msg(id,text){if(el(id))el(id).textContent=text||''}
async function signUp(){const email=el('email').value.trim(),password=el('password').value;if(!email||password.length<6)return msg('authMsg','Enter a valid email and password (minimum 6 characters).');const {error}=await db.auth.signUp({email,password});msg('authMsg',error?errText(error):'Account created. If email confirmation is enabled, check your inbox.')}
async function signIn(){const email=el('email').value.trim(),password=el('password').value;const {data,error}=await db.auth.signInWithPassword({email,password});if(error)return msg('authMsg',errText(error));await boot(data.user)}
async function resetPassword(){const email=el('email').value.trim();if(!email)return msg('authMsg','Enter your email first.');const {error}=await db.auth.resetPasswordForEmail(email,{redirectTo:location.origin+location.pathname});msg('authMsg',error?errText(error):'Password reset email sent if the account exists.')}
async function signOut(){await db.auth.signOut();currentUser=null;el('appSection').classList.add('hidden');el('authSection').classList.remove('hidden')}
async function boot(user){currentUser=user;el('authSection').classList.add('hidden');el('appSection').classList.remove('hidden');renderExplore();renderCountries();renderUniversities();renderPhrase();await Promise.allSettled([loadFeed(),loadTrips(),loadSkills(),loadNotifications(),loadSaved(),loadProfile()])}
function showPage(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.add('hidden'));el(id).classList.remove('hidden');document.querySelectorAll('#tabs button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='mapPage')setTimeout(initMap,100);if(id==='community')loadFeed();if(id==='travel')loadTrips();if(id==='career')loadSkills();if(id==='alerts')loadNotifications();if(id==='saved')loadSaved();if(id==='profile')loadProfile()}
const discoveries=[
{id:'study-malaysia',title:'Study in Malaysia',category:'Study',description:'Explore foundation, diploma and bachelor pathways.',details:'Compare official university entry requirements, tuition, scholarships and living costs before applying.',keywords:'malaysia foundation diploma bachelor admission'},
{id:'learn-programming',title:'Start learning programming',category:'Skills',description:'Build a foundation in coding and problem solving.',details:'Start with HTML, CSS and JavaScript, then explore Python and databases.',keywords:'coding computer science software python'},
{id:'travel-japan',title:'Discover Japan',category:'Travel',description:'Explore culture, cities and travel planning.',details:'Research transport, accommodation, local customs and entry rules.',keywords:'japan tokyo travel culture'},
{id:'career-ai',title:'Explore artificial intelligence',category:'Career',description:'Learn what AI is and which skills support the field.',details:'Build foundations in mathematics, programming, data and responsible AI.',keywords:'ai artificial intelligence career technology'},
{id:'language-german',title:'Learn German basics',category:'Culture',description:'Practice useful everyday German phrases.',details:'Start with greetings, introductions and simple questions.',keywords:'german language europe'},
{id:'plan-budget',title:'Plan a travel budget',category:'Travel',description:'Organize transport, food and accommodation estimates.',details:'Keep emergency funds separate and verify prices before booking.',keywords:'budget travel planning money'}
];
const countries=[['Bangladesh','Dhaka','Asia'],['Malaysia','Kuala Lumpur','Asia'],['Japan','Tokyo','Asia'],['South Korea','Seoul','Asia'],['Germany','Berlin','Europe'],['United Kingdom','London','Europe'],['United States','Washington, D.C.','North America'],['Canada','Ottawa','North America'],['Australia','Canberra','Oceania'],['France','Paris','Europe'],['Turkey','Ankara','Europe/Asia'],['Singapore','Singapore','Asia']];
const universities=[['INTI International University','Malaysia','Nilai'],['Asia Pacific University (APU)','Malaysia','Kuala Lumpur'],['University of Malaya','Malaysia','Kuala Lumpur'],['University of Oxford','United Kingdom','Oxford'],['Technical University of Munich','Germany','Munich'],['University of Tokyo','Japan','Tokyo']];
function renderExplore(){const q=(el('exploreSearch')?.value||'').toLowerCase().trim(),cat=el('exploreCategory')?.value||'All';const list=discoveries.filter(d=>(cat==='All'||d.category===cat)&&[d.title,d.category,d.description,d.details,d.keywords].join(' ').toLowerCase().includes(q));msg('exploreCount',`${list.length} discoveries found`);el('exploreList').innerHTML=list.map(d=>`<article class="item"><span class="pill">${safe(d.category)}</span><h3>${safe(d.title)}</h3><p>${safe(d.description)}</p><p class="small">${safe(d.details)}</p><button class="secondary" onclick="saveDiscovery('${d.id}')">♡ Save</button><button class="secondary" onclick="shareDiscovery('${d.id}')">Share</button></article>`).join('')||'<p class="muted">No results found.</p>'}
function renderCountries(){const q=(el('countrySearch')?.value||'').toLowerCase();el('countryList').innerHTML=countries.filter(c=>c.join(' ').toLowerCase().includes(q)).map(c=>`<div class="item"><span class="pill">${safe(c[2])}</span><h3>${safe(c[0])}</h3><p>Capital: ${safe(c[1])}</p></div>`).join('')||'<p>No countries found.</p>'}
function renderUniversities(){const q=(el('uniSearch')?.value||'').toLowerCase();el('uniList').innerHTML=universities.filter(u=>u.join(' ').toLowerCase().includes(q)).map(u=>`<div class="item"><h3>${safe(u[0])}</h3><p>${safe(u[1])} · ${safe(u[2])}</p></div>`).join('')||'<p>No universities found.</p>'}
async function createPost(){if(!currentUser)return;const content=el('postText').value.trim();if(!content)return msg('postMsg','Write something first.');const {error}=await db.from('posts').insert({user_id:currentUser.id,content});if(error)return msg('postMsg',errText(error));el('postText').value='';msg('postMsg','Post published.');loadFeed()}
async function loadFeed(){if(!currentUser)return;const {data,error}=await db.from('posts').select('*').order('created_at',{ascending:false}).limit(50);if(error){el('feed').innerHTML=`<p class="muted">${safe(errText(error))}</p>`;return}el('feed').innerHTML=(data||[]).map(p=>`<div class="item"><p>${safe(p.content||p.body||'')}</p><span class="small">${p.created_at?new Date(p.created_at).toLocaleString():''}</span><div><button class="secondary" onclick="toggleLike('${p.id}')">♡ Like</button><button class="secondary" onclick="commentPrompt('${p.id}')">Comment</button><button class="secondary" onclick="sharePost('${p.id}')">Share</button></div><div id="comments-${p.id}"></div></div>`).join('')||'<p class="muted">No posts yet. Start the conversation.</p>'}
async function toggleLike(postId){const {data,error}=await db.from('post_likes').select('id').eq('post_id',postId).eq('user_id',currentUser.id).maybeSingle();if(error)return alert(errText(error));const result=data?await db.from('post_likes').delete().eq('id',data.id):await db.from('post_likes').insert({post_id:postId,user_id:currentUser.id});if(result.error)alert(errText(result.error))}
async function commentPrompt(postId){const content=prompt('Write your comment:');if(!content?.trim())return;const {error}=await db.from('post_comments').insert({post_id:postId,user_id:currentUser.id,content:content.trim()});if(error)alert(errText(error));else loadComments(postId)}
async function loadComments(postId){const {data,error}=await db.from('post_comments').select('*').eq('post_id',postId).order('created_at');const node=el('comments-'+postId);if(!node)return;if(error){node.textContent=errText(error);return}node.innerHTML=(data||[]).map(c=>`<p class="small">${safe(c.content||c.comment||'')}</p>`).join('')}
async function sharePost(id){const url=location.href+'#post-'+id;if(navigator.share){try{await navigator.share({title:'Wayfinder post',url})}catch(e){}}else if(navigator.clipboard){await navigator.clipboard.writeText(url);alert('Link copied.')}}
async function saveDiscovery(id){const d=discoveries.find(x=>x.id===id);if(!d||!currentUser)return;const {error}=await db.from('saved_items').insert({user_id:currentUser.id,item_type:'discovery',item_id:id,title:d.title,details:d.description});if(error){if(error.code==='23505')return alert('Already saved.');return alert(errText(error))}alert('Saved to your list.')}
async function shareDiscovery(id){const d=discoveries.find(x=>x.id===id);if(!d)return;const text=d.title+' — '+d.description;if(navigator.share){try{await navigator.share({title:d.title,text})}catch(e){}}else{await navigator.clipboard?.writeText(text);alert('Copied.')}}
function initMap(){if(map)return;if(!window.L)return;map=L.map('map').setView([20,0],2);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; OpenStreetMap contributors'}).addTo(map);[['Dhaka',23.8103,90.4125],['Kuala Lumpur',3.139,101.6869],['Tokyo',35.6762,139.6503],['London',51.5072,-0.1276],['New York',40.7128,-74.006]].forEach(p=>L.marker([p[1],p[2]]).addTo(map).bindPopup(p[0]))}
async function saveTrip(){if(!currentUser)return;const destination=el('tripDestination').value.trim();if(!destination)return msg('tripMsg','Enter a destination.');const {error}=await db.from('travel_plans').insert({user_id:currentUser.id,destination,travel_date:el('tripDate').value||null,notes:el('tripNotes').value.trim()});if(error)return msg('tripMsg',errText(error));msg('tripMsg','Travel plan saved.');el('tripDestination').value='';el('tripDate').value='';el('tripNotes').value='';loadTrips()}
async function loadTrips(){if(!currentUser)return;const {data,error}=await db.from('travel_plans').select('*').eq('user_id',currentUser.id).order('created_at',{ascending:false});if(error){el('tripList').textContent=errText(error);return}el('tripList').innerHTML=(data||[]).map(t=>`<div class="item"><b>${safe(t.destination||t.title||'Trip')}</b><p>${safe(t.travel_date||'Date not set')}</p><p>${safe(t.notes||'')}</p><button class="danger" onclick="deleteTrip('${t.id}')">Delete</button></div>`).join('')||'<p class="muted">Nothing saved yet.</p>'}
async function removeSaved(id){const {error}=await db.from('saved_items').delete().eq('id',id).eq('user_id',currentUser.id);if(error)alert(errText(error));else loadSaved()}
async function loadProfile(){if(!currentUser)return;const {data,error}=await db.from('profiles').select('id,full_name').eq('id',currentUser.id).maybeSingle();if(error){msg('profileMsg',errText(error));return}el('profileName').value=data?.full_name||''}
async function saveProfile(){if(!currentUser)return msg('profileMsg','Please log in first.');const full_name=el('profileName').value.trim();const {error}=await db.from('profiles').upsert({id:currentUser.id,full_name},{onConflict:'id'});msg('profileMsg',error?errText(error):'Profile saved successfully.')}
db.auth.getSession().then(({data,error})=>{if(error)return msg('authMsg',errText(error));if(data.session)boot(data.session.user)}).catch(e=>msg('authMsg',errText(e)));
db.auth.onAuthStateChange((event,session)=>{if(event==='SIGNED_OUT'){currentUser=null;el('appSection').classList.add('hidden');el('authSection').classList.remove('hidden')}});
</script>
</body>
</html>